{
  "name": "@mints/request",
  "packageManager": "pnpm@10.16.1",
  "version": "2.2.0",
  "type": "module",
  "description": "A lightweight Axios + operation wrapper with global config and toast integration",
  "keywords": [
    "axios",
    "request",
    "operator",
    "toast",
    "react",
    "vite",
    "http",
    "utility"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mints-components/request.git"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "lint": "eslint . --fix",
    "prettier": "prettier . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublish": "pnpm build",
    "release": "pnpm publish --access public",
    "prepare": "husky install",
    "prepack": "pinst --disable",
    "postpack": "pinst --enable"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{html,json,md}": [
      "prettier --write"
    ]
  },
  "peerDependencies": {
    "axios": ">=1",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mints/eslint-config": "^2.2.0",
    "axios": "^1.11.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.32.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.1.2",
    "msw": "^2.14.6",
    "pinst": "^3.0.0",
    "prettier": "^3.6.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsup": "^7.2.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.7"
  }
}
